    },
    {
      "id": "ee140fe0-8e34-4af6-becd-c1c6f7c83578",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        80
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "actor",
              "name": "actorId",
              "value": "SET_VERIFIED_ACTOR_ID",
              "type": "string"
            },
            {
              "id": "board",
              "name": "boardUrl",
              "value": "https://jobs.ashbyhq.com/ramp",
              "type": "string"
            },
            {
              "id": "watch",
              "name": "watchId",
              "value": "current-jobs",
              "type": "string"
            },
            {
              "id": "webhook",
              "name": "webhookUrl",
              "value": "https://example.com/replace-with-your-webhook",
